 }
 
+// [vpw64dx] Map one registered section (by its exact rom offset) at a given address, for code
+// the game puts in place without a DMA. Unlike load_overlays this tolerates nested sections.
+extern "C" void load_section_by_rom(uint32_t rom, int32_t ram) {
+    auto it = code_sections_by_rom.find(rom);
+    if (it == code_sections_by_rom.end()) {
+        fprintf(stderr, "[vpw64dx][ovl] no section at rom 0x%07X\n", rom);
+        return;
+    }
+    fprintf(stderr, "[vpw64dx][ovl] section rom=0x%07X mapped at 0x%08X\n", rom, (uint32_t)ram);
+    load_overlay(it->second, ram);
+}
