+// [vpw64dx] Map one registered section (by its exact rom offset) at a given address, for code
+// the game puts in place without a DMA. Unlike load_overlays this tolerates nested sections.
+extern "C" void load_section_by_rom(uint32_t rom, int32_t ram) {
+    auto it = code_sections_by_rom.find(rom);
+    if (it == code_sections_by_rom.end()) {
+        fprintf(stderr, "[vpw64dx][ovl] no section at rom 0x%07X\n", rom);
+        return;
+    }
+    fprintf(stderr, "[vpw64dx][ovl] section rom=0x%07X mapped at 0x%08X\n", rom, (uint32_t)ram);
+    load_overlay(it->second, ram);
+}
+
+// [vpw64dx] Move a section (named by its exact rom offset) to a new address: the hack's
+// match-time block is read into a game-allocated buffer, so it may land somewhere else for
+// another match type. Called from the DMA hook when the block's first piece is read.
+extern "C" void remap_section_by_rom(uint32_t rom, int32_t ram) {
+    auto it = code_sections_by_rom.find(rom);
+    if (it == code_sections_by_rom.end()) return;
+    uint16_t section_table_index = it->second;
+    const SectionTableEntry& section = sections_info.code_sections[section_table_index];
+    auto find_it = std::find_if(loaded_sections.begin(), loaded_sections.end(), [section_table_index](const LoadedSection& s) { return s.section_table_index == section_table_index; });
+    if (find_it != loaded_sections.end()) {
+        if (find_it->loaded_ram_addr == ram) return;
+        for (size_t func_index = 0; func_index < section.num_funcs; func_index++) {
+            func_map.erase(section.funcs[func_index].offset + find_it->loaded_ram_addr);
+        }
+        loaded_sections.erase(find_it);
+    }
+    fprintf(stderr, "[vpw64dx][ovl] section rom=0x%07X moved to 0x%08X\n", rom, (uint32_t)ram);
+    load_overlay(section_table_index, ram);
+}
